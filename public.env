# ==============================================================================
# QUILLAN-RONIN v5.4.0 ONI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (which is git-ignored) and populate your own API keys.
# NEVER commit your real '.env' file or private credentials to GitHub.
# ==============================================================================

# Core System Settings
DEBUG=False
PORT=8080
LOG_LEVEL=INFO
DEVICE=auto

# NVIDIA NIM / Enterprise Inference (https://build.nvidia.com)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini / Vertex AI (https://aistudio.google.com)
GEMINI_API_KEY=

# Hugging Face Model & Dataset Sync (https://huggingface.co/settings/tokens)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI API (https://platform.openai.com)
OPENAI_API_KEY=

# X (Twitter) Developer API (https://developer.x.com)
X_BEARER_TOKEN=
X_CLIENT_SECRET=

# Local Persistent Storage Paths
QUILLAN_RAG_DB=C:\02_QUILLAN\quillan_rag_db
QUILLAN_CHECKPOINTS=C:\02_QUILLAN\checkpoints
