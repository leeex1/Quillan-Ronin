# No Git LFS — all media/datasets live on Hugging Face, not in this repo.
# Binary assets are never tracked here (see .gitignore). This file only
# forces text handling so GitHub Pages never serves LFS pointers.
* text=auto eol=lf
*.bin -filter -diff -merge text
*.pt -filter -diff -merge text
*.pth -filter -diff -merge text
*.safetensors -filter -diff -merge text
*.pkl -filter -diff -merge text
*.png -filter -diff -merge -text
*.jpg -filter -diff -merge -text
*.jpeg -filter -diff -merge -text
*.gif -filter -diff -merge -text
*.bmp -filter -diff -merge -text
*.ico -filter -diff -merge -text
*.svg -filter -diff -merge text
*.pdf -filter -diff -merge -text
*.html -filter -diff -merge text
*.obj -filter -diff -merge -text
*.zip -filter -diff -merge -text
*.tar.gz -filter -diff -merge -text
*.flac -filter -diff -merge -text
*.mp3 -filter -diff -merge -text
*.m4a -filter -diff -merge -text
*.wav -filter -diff -merge -text
*.pb -filter -diff -merge -text
*.webp -filter -diff -merge -text
*.glb -filter -diff -merge -text
*.epub -filter -diff -merge -text
*.vst3 -filter -diff -merge -text
*.pyd -filter -diff -merge -text
*.exe -filter -diff -merge -text
*.dll -filter -diff -merge -text
*.ogg -filter -diff -merge -text
*.ttf -filter -diff -merge -text
*.otf -filter -diff -merge -text
