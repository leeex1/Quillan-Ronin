; Engine configuration file.
; Ronin Thronglets - Thronglets-style samurai robot swarm sim
[application]
config/name="Ronin Thronglets"
config/version="0.1.0"
run/main_scene="res://scenes/Title.tscn"
config/icon="res://assets/icon.png"
config/description="A Thronglets-style raise-and-evolve swarm sim: cute-menacing samurai robot thralls on a floating cyber-temple dojo."
config/company_name="CrashOverrideX / Quillan-Ronin"

[autoload]
GameState="*res://scripts/GameState.gd"
Dialogue="*res://scripts/Dialogue.gd"

[display]
window/size/initial_position_type=2
window/always_on_top=true
window/size/resizable=false
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/title="Ronin Thronglets"

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.02, 0.015, 0.05, 1)

[input]
toggle_console={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":96,"key_label":0,"unicode":96,"location":0,"echo":false,"script":null)
]
}
swarm_ability={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":81,"key_label":0,"unicode":113,"location":0,"echo":false,"script":null)
]
}
