{
  "name": "nextverse-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-End Testing Suite for NextVerse Platform",
  "main": "index.js",
  "scripts": {
    "setup": "bash setup.sh",
    "test": "jest --config jest.config.js",
    "test:phase1": "jest --config jest.config.js alpha-phase1-tests.js",
    "test:phase2": "jest --config jest.config.js alpha-phase2-tests.js",
    "test:phase3": "jest --config jest.config.js alpha-phase3-tests.js",
    "test:phase4": "jest --config jest.config.js alpha-phase4-tests.js",
    "test:phase5": "jest --config jest.config.js alpha-phase5-tests.js",
    "test:quick": "jest --config jest.config.js smoke.test.js",
    "report:generate": "node generate-report.js"
