    "dotenv": "^16.0.3",
    "puppeteer": "^19.7.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "jest-html-reporter": "^3.7.0",
    "jest-junit": "^17.0.0"
  }
