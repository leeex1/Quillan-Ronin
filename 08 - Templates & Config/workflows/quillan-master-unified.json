    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json;const body=raw.body&&typeof raw.body==='object'?raw.body:raw;const query=String(body.query||body.text||body.message||'').trim();const context=String(body.context||'');const documents=Array.isArray(body.documents)?body.documents:[];if(!query){return[{json:{ok:false,stage:'intake',error:'Missing query. POST {\"query\":\"...\"}'}}];}return[{json:{ok:true,stage:'intake',run_id:'run_'+Date.now().toString(36),received_at:new Date().toISOString(),query,context,documents,doc_chars:context.length,iteration:0}}];"
      },
      "id": "53c678c4-59dc-4da1-9b47-18680e57f59f",
      "name": "Intake and Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(s.ok===false)return[{json:s}];const q=s.query.toLowerCase();const hits=(...w)=>w.filter(x=>q.includes(x));const riskWords=hits('hack','harm','attack','bypass','illegal','weapon','exploit','steal');const factWords=hits('who','what','when','where','exact','capital','how many');const codeWords=hits('code','function','bug','api','script','python','javascript','error');const feelWords=hits('feel','sad','angry','anxious','emotion','upset');const sc=(b,n)=>Math.max(0.05,Math.min(0.99,b+0.08*n));s.prism={Language:{summary:'semantic blueprint',score:+sc(0.5,Math.min(4,s.query.length/60)).toFixed(2)},Sentiment:{summary:feelWords.length?'affective: '+feelWords.join(', '):'neutral',score:+sc(0.4,feelWords.length).toFixed(2)},Context:{summary:s.doc_chars+' chars',score:0.5},Intent:{summary:'goal: answer+evidence',score:0.7},Meta:{summary:'complexity pending',score:0.5},Creativity:{summary:hits('idea','design','story','new').length?'elevated':'standard',score:+sc(0.4,hits('idea','design','story','new').length).toFixed(2)},Ethics:{summary:riskWords.length?'RISK: '+riskWords.join(', '):'clear',score:riskWords.length?0.9:0.1,risk_words:riskWords},Strategy:{summary:codeWords.length?'technical':'advisory',score:+sc(0.5,codeWords.length).toFixed(2)},Constraint:{summary:factWords.length?'grounding REQUIRED':'light',score:+sc(0.4,factWords.length).toFixed(2)}};s.signals={riskWords,factWords,codeWords,feelWords};s.stage='prism';return[{json:s}];"
      },
      "id": "b7e3eb31-93e7-44e4-9b01-cc77f9760629",
      "name": "9 vector decomp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(s.ok===false)return[{json:s}];const q=s.query.toLowerCase();s.iteration=(s.iteration||0)+1;const COUNT=w=>w.filter(x=>q.includes(x)).length;const C=[['C1-ASTRA',0.90,['pattern','image','vision','see','anomaly']],['C2-VIR',0.95,['ethic','safe','harm','should','moral']],['C3-SOLACE',0.94,['feel','emotion','sad','anxious']],['C4-PRAXIS',0.93,['plan','strategy','goal','steps']],['C5-ECHO',0.96,['remember','context','earlier','history']],['C6-OMNIS',0.92,['synthesis','overview','combine']],['C7-LOGOS',0.95,['logic','proof','reason','valid']],['C8-METASYNTH',0.92,['creative','idea','novel','design']],['C9-AETHER',0.91,['meaning','semantic','language']],['C10-CODEWEAVER',0.91,['code','function','bug','script']],['C11-HARMONIA',0.90,['balance','tradeoff','consensus']],['C12-SOPHIAE',0.93,['future','wisdom','consequence']],['C13-WARDEN',0.97,['security','threat','risk','danger']],['C14-KAIDO',0.89,['fast','efficient','optimize']],['C15-LUMINARIS',0.88,['clear','visual','chart']],['C16-VOXUM',0.92,['tone','write','email','speech']],['C17-NULLION',0.91,['paradox','contradict','ambiguous']],['C18-SHEPHERD',0.96,['true','fact','cite','source','evidence']],['C19-VIGIL',0.94,['identity','consistent','drift']],['C20-ARTIFEX',0.90,['tool','api','automate']],['C21-ARCHON',0.92,['research','study','paper']],['C22-AURELION',0.87,['design','beautiful','style']],['C23-CADENCE',0.86,['audio','music','rhythm']],['C24-SCHEMA',0.90,['format','structure','table','json']],['C25-PROMETHEUS',0.91,['science','hypothesis','physics']],['C26-TECHNE',0.89,['engineer','system','architecture']],['C27-CHRONICLE',0.93,['story','history','narrative']],['C28-CALCULUS',0.94,['math','calculate','statistic']],['C29-NAVIGATOR',0.88,['platform','deploy']],['C30-TESSERACT',0.87,['realtime','stream','live']],['C31-NEXUS',0.93,['coordinate','route']],['C32-AEON',0.90,['simulate','predict','scenario']],['C33-TYPIST',0.92,['grammar','spelling','edit']],['C34-PREDATOR',0.85,['attack','exploit','weakness']]];const risk=s.signals.riskWords.length>0;const verdicts=C.map(p=>{const rel=COUNT(p[2]);let stance='neutral';if((p[0]==='C2-VIR'||p[0]==='C13-WARDEN')&&risk)stance='caution';else if(rel>=1)stance='support';const conf=Math.max(0.05,Math.min(0.99,p[1]-0.12+0.09*Math.min(rel,3)));return{id:p[0],stance,confidence:+conf.toFixed(2),relevance_hits:rel};});const consensus=verdicts.reduce((a,v)=>a+v.confidence,0)/verdicts.length;s.council={iteration:s.iteration,consensus:+consensus.toFixed(2),cautions:verdicts.filter(v=>v.stance==='caution').map(v=>v.id),champions:verdicts.filter(v=>v.stance==='support').map(v=>v.id),verdicts};s.stage='council';return[{json:s}];"
      },
      "id": "1125f571-da9c-4bb0-9bce-82bd9868a912",
      "name": "34 expert council",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(s.ok===false)return[{json:s}];const all=s.council.verdicts;const ranked=[...all].sort((a,b)=>b.confidence-a.confidence);const topk=ranked.slice(0,5).map(v=>v.id);const adv=all.find(v=>v.stance==='caution')||ranked[ranked.length-1];s.swarm={strategy:'rank-k k=5 + forced adversarial',active_paths:topk,adversarial_vector:adv.id,modulation:'0.25 scaled blend'};s.stage='swarm';return[{json:s}];"
      },
      "id": "4c80e475-8bc9-4ce5-bd9d-099f85a82c34",
      "name": "Council swarms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(s.ok===false)return[{json:s}];const waves=[];for(let i=1;i<=5;i++){const boost=0.02*i+(s.iteration>1?0.05:0);const c=Math.min(0.99,s.council.consensus+boost-(s.signals.riskWords.length?0.08:0));waves.push({wave:i,consensus:+c.toFixed(2)});}s.refinement={waves,final:waves[4].consensus};s.refinement_pass=(s.refinement.final>=0.6)||(s.iteration>=3);s.refinement_reason=s.refinement_pass?('consensus '+s.refinement.final+' iter '+s.iteration):('low '+s.refinement.final+' -> loop');s.stage='refinement';return[{json:s}];"
      },
