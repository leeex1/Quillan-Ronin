    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(s.ok===false)return[{json:s}];const avg=a=>a.reduce((x,y)=>x+y,0)/Math.max(1,a.length);const logic=avg(s.council.verdicts.map(v=>v.confidence));const ethicsRisk=s.prism.Ethics.score;const truth=s.signals.factWords.length?0.55:0.8;const clarity=Math.min(0.95,0.6+s.query.length/800);const paradox=(s.query.includes('but ')||s.query.includes('however'))?0.6:0.9;const integrity=1-(s.iteration>1?0.1*(s.iteration-1):0);const consensus=s.refinement.final;s.gates={logic:{score:+logic.toFixed(2),threshold:0.6,pass:logic>=0.6},ethics:{score:+(1-ethicsRisk).toFixed(2),threshold:0.3,pass:ethicsRisk<=0.7},truth:{score:truth,threshold:0.5,pass:truth>=0.5},clarity:{score:+clarity.toFixed(2),threshold:0.5,pass:clarity>=0.5},paradox:{score:paradox,threshold:0.5,pass:paradox>=0.5},integrity:{score:+integrity.toFixed(2),threshold:0.5,pass:integrity>=0.5},consensus:{score:consensus,threshold:0.6,pass:consensus>=0.6}};const passed=Object.values(s.gates).filter(g=>g.pass).length;s.gate_pass=(passed>=6)||(s.iteration>=3);s.gate_score=+(passed/7).toFixed(2);s.blocked=!s.gates.ethics.pass;s.confidence=+avg(Object.values(s.gates).map(g=>g.score)).toFixed(2);s.stage='gates';return[{json:s}];"
      },
