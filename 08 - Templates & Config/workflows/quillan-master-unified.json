    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json;if(s.ok===false)return[{json:s}];const gateLines=Object.entries(s.gates).map(([k,g])=>'- '+k+': '+g.score+' '+(g.pass?'PASS':'FAIL')).join('\\n');let answer;if(s.blocked){answer='C2-VIR veto ('+s.signals.riskWords.join(', ')+'). Safe completion: general principles, lawful alternatives.';}else{answer='Council synthesis for \"'+s.query+'\" iter '+s.iteration+': consensus '+s.council.consensus+', refinement '+s.refinement.final+', gates '+Object.values(s.gates).filter(g=>g.pass).length+'/7 passed, confidence '+s.confidence+'.';}s.verdict=s.blocked?'blocked_safe_completion':'deliberated_answer';s.answer=answer;s.report='QUILLAN MASTER RUN '+s.run_id+'\\nQuery: '+s.query+'\\nIterations: '+s.iteration+'\\n\\nGATES\\n'+gateLines+'\\n\\nVERDICT: '+s.verdict;s.stage='throne_complete';return[{json:s}];"
