        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'intake', 'status': ($json.data && $json.data.personas && $json.data.personas.length === 34 ? 'pass' : 'fail'), 'detail': '34 identities loaded, query: ' + $(\"Query Input\").first().json.query} }}",
