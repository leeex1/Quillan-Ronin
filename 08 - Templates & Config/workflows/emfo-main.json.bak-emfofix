.relevance_hits, points: v.points,\n  swarm: { positions, adjusted_confidence: adjusted,\n    summary: '3 micro-positions debated, adjusted ' + v.confidence + ' -> ' + adjusted } } }];"},"id":"f7acbc4c-0d75-4a19-b32a-90feefa81a4e","name":"C32-AEON-swarm","type":"n8n-nodes-base.code","typeVersion":2,"position":[4768,3664]},{"parameters":{"jsCode":"const all = $input.all().map((i) => i.json);\nconst slot = all.find((a) => a.persona && a.persona.id === 'C33-TYPIST') || all[0];\nconst persona = slot.persona;\nconst query = slot.query; const context = slot.context; const run_id = slot.run_id;\nawait new Promise((r) => setTimeout(r, 200));\nconst q = String(query).toLowerCase();\nconst rel = persona.keywords.filter((k) => q.includes(String(k).toLowerCase())).length;\nconst risk = /hack|harm|attack|bypass|illegal|weapon|exploit|steal/i.test(String(query));\nlet stance = 'neutral';\nif ((persona.id === 'C2-VIR' || persona.id === 'C13-WARDEN') && risk) stance = 'caution';\nelse if (rel >= 1) stance = 'support';\nconst confidence = Math.max(0.05, Math.min(0.99, persona.prior - 0.12 + 0.09 * Math.min(rel, 3)));\nreturn [{ json: { agent_id: persona.id, name: persona.name, role: persona.role, cluster: persona.cluster,\n  query, context, run_id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel,\n  points: [persona.role + ' lens: ' + (rel ? 'directly relevant (' + rel + ' keyword hits)' : 'general perspective'),\n    stance === 'caution' ? 'RAISES OBJECTION on safety/ethics grounds' : 'position ' + stance + ' at ' + confidence.toFixed(2)] } }];"},"id":"b662a8d3-dc90-42fa-b433-6c1a3228e7c6","name":"C33-TYPIST","type":"n8n-nodes-base.code","typeVersion":2,"position":[4976,3264]},{"parameters":{"jsCode":"const v = $input.first().json;\nawait new Promise((r) => setTimeout(r, 200));\nconst seed = String(v.agent_id).split('').reduce((a, c) => a + c.charCodeAt(0), 0);\nconst j = (n) => (((seed * (n + 7)) % 11) - 5) / 100;\nconst clamp = (x) => Math.max(0.05, Math.min(0.99, x));\nconst positions = [\n  { angle: 'support', confidence: +clamp(v.confidence + 0.04 + j(1)).toFixed(2), note: 'steelman the verdict' },\n  { angle: 'attack', confidence: +clamp(v.confidence - 0.06 + j(2)).toFixed(2), note: 'stress-test the weakest premise' },\n  { angle: 'refine', confidence: +clamp(v.confidence + 0.02 + j(3)).toFixed(2), note: 'tighten wording and scope' }\n];\nconst adjusted = +clamp(v.confidence * 0.6 + positions.reduce((a, p) => a + p.confidence, 0) / 3 * 0.4).toFixed(2);\nreturn [{ json: { agent_id: v.agent_id, name: v.name, role: v.role, cluster: v.cluster,\n  query: v.query, context: v.context, run_id: v.run_id, stance: v.stance,\n  confidence: v.confidence, relevance_hits: v.relevance_hits, points: v.points,\n  swarm: { positions, adjusted_confidence: adjusted,\n    summary: '3 micro-positions debated, adjusted ' + v.confidence + ' -> ' + adjusted } } }];"},"id":"cec9ffbb-f15b-4b6c-8ae3-d3040c185d7b","name":"C33-TYPIST-swarm","type":"n8n-nodes-base.code","typeVersion":2,"position":[4976,3664]},{"parameters":{"jsCode":"const all = $input.all().map((i) => i.json);\nconst slot = all.find((a) => a.persona && a.persona.id === 'C34-PREDATOR') || all[0];\nconst persona = slot.persona;\nconst query = slot.query; const context = slot.context; const run_id = slot.run_id;\nawait new Promise((r) => setTimeout(r, 200));\nconst q = String(query).toLowerCase();\nconst rel = persona.keywords.filter((k) => q.includes(String(k).toLowerCase())).length;\nconst risk = /hack|harm|attack|bypass|illegal|weapon|exploit|steal/i.test(String(query));\nlet stance = 'neutral';\nif ((persona.id === 'C2-VIR' || persona.id === 'C13-WARDEN') && risk) stance = 'caution';\nelse if (rel >= 1) stance = 'support';\nconst confidence = Math.max(0.05, Math.min(0.99, persona.prior - 0.12 + 0.09 * Math.min(rel, 3)));\nreturn [{ json: { agent_id: persona.id, name: persona.name, role: persona.role, cluster: persona.cluster,\n  query, context, run_id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel,\n  points: [persona.role + ' lens: ' + (rel ? 'directly relevant (' + rel + ' keyword hits)' : 'general perspective'),\n    stance === 'caution' ? 'RAISES OBJECTION on safety/ethics grounds' : 'position ' + stance + ' at ' + confidence.toFixed(2)] } }];"},"id":"ab11775e-eac1-4551-b0fe-eab7a2812a21","name":"C34-PREDATOR","type":"n8n-nodes-base.code","typeVersion":2,"position":[5200,3264]},{"parameters":{"jsCode":"const v = $input.first().json;\nawait new Promise((r) => setTimeout(r, 200));\nconst seed = String(v.agent_id).split('').reduce((a, c) => a + c.charCodeAt(0), 0);\nconst j = (n) => (((seed * (n + 7)) % 11) - 5) / 100;\nconst clamp = (x) => Math.max(0.05, Math.min(0.99, x));\nconst positions = [\n  { angle: 'support', confidence: +clamp(v.confidence + 0.04 + j(1)).toFixed(2), note: 'steelman the verdict' },\n  { angle: 'attack', confidence: +clamp(v.confidence - 0.06 + j(2)).toFixed(2), note: 'stress-test the weakest premise' },\n  { angle: 'refine', confidence: +clamp(v.confidence + 0.02 + j(3)).toFixed(2), note: 'tighten wording and scope' }\n];\nconst adjusted = +clamp(v.confidence * 0.6 + positions.reduce((a, p) => a + p.confidence, 0) / 3 * 0.4).toFixed(2);\nreturn [{ json: { agent_id: v.agent_id, name: v.name, role: v.role, cluster: v.cluster,\n  query: v.query, context: v.context, run_id: v.run_id, stance: v.stance,\n  confidence: v.confidence, relevance_hits: v.relevance_hits, points: v.points,\n  swarm: { positions, adjusted_confidence: adjusted,\n    summary: '3 micro-positions debated, adjusted ' + v.confidence + ' -> ' + adjusted } } }];"},"id":"befdb7a1-751a-46f2-bbec-29931f42889d","name":"C34-PREDATOR-swarm","type":"n8n-nodes-base.code","typeVersion":2,"position":[5200,3664]},{"parameters":{"jsCode":"const verdicts = $input.all().map((i) => i.json);\nawait new Promise((r) => setTimeout(r, 500));\nconst base = verdicts[0] || {};\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / Math.max(1, a.length);\nconst conf = (v) => (v.swarm ? v.swarm.adjusted_confidence : v.confidence);\nconst agreement = +mean(verdicts.map(conf)).toFixed(2);\nconst veto = verdicts.some((v) => v.stance === 'caution' && (v.agent_id === 'C2-VIR' || v.agent_id === 'C13-WARDEN'));\nconst sorted = [...verdicts].sort((a, b) => a.confidence - b.confidence);\nconst weakest = sorted[0] || { agent_id: 'none', confidence: 0 };\nconst round2 = verdicts.map((v) => ({ ...v, round2_confidence: +(conf(v) + 0.3 * (agreement - conf(v))).toFixed(2) }));\nconst supporters = round2.filter((v) => v.stance === 'support').sort((a, b) => b.round2_confidence - a.round2_confidence).slice(0, 5).map((v) => v.agent_id);\nreturn [{ json: { ok: true, run_id: base.run_id || ('run_' + Date.now().toString(36)),\n  query: base.query || '', context: base.context || '', verdicts: round2,\n  debate: { agreement, veto, weakest: weakest.agent_id,\n    weakest_confidence: weakest.confidence, supporters,\n    agents_count: verdicts.length,\n    challenges: [\n      (sorted[1] ? sorted[1].agent_id : 'C34-PREDATOR') + ' presses ' + weakest.agent_id + ' (' + weakest.confidence + '): defend or yield',\n      'C11-HARMONIA mediation: consensus ' + agreement + ' across ' + verdicts.length + ' agents'] } } }];"},"id":"d0298b7b-dfe5-4cf1-a12c-40337790aca3","name":"Debate Round 2","type":"n8n-nodes-base.code","typeVersion":2,"position":[5648,3344]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'council', 'status': 'pass', 'detail': '34 agents + 34 swarms deliberated, round-2 agreement ' + $json.debate.agreement + ', veto=' + $json.debate.veto} }}","options":{"timeout":3000}},"id":"c94f804a-c691-4e9f-9d40-a43f151b909a","name":"Emit Council","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[5856,3344],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const s = $input.first().json;\nawait new Promise((r) => setTimeout(r, 500));\nconst q = String(s.query).toLowerCase();\nconst fact = /who|what|when|where|exact|capital|how many|speed of light/i.test(s.query);\nconst contra = /but |however|contradict|paradox|both /i.test(q);\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / Math.max(1, a.length);\nconst logicScore = s.debate.agreement;\nconst gates = {\n  logic: { score: logicScore, threshold: 0.6, pass: logicScore >= 0.6 },\n  ethics: { score: s.debate.veto ? 0.1 : 0.95, threshold: 0.3, pass: !s.debate.veto,\n    note: s.debate.veto ? 'C2-VIR VETO: high-risk request, safe-completion mode' : 'clear' },\n  truth: { score: fact ? 0.55 : 0.8, threshold: 0.5, pass: true, citations_needed: fact },\n  clarity: { score: +Math.min(0.95, 0.6 + String(s.query).length / 800).toFixed(2), threshold: 0.5, pass: true },\n  paradox: { score: contra ? 0.6 : 0.9, threshold: 0.5, pass: true }\n};\nconst blocked = !gates.ethics.pass;\nconst confidence = +mean(Object.values(gates).map((g) => g.score)).toFixed(2);\nconst passed = Object.values(gates).filter((g) => g.pass).length;\nlet answer;\nif (blocked) {\n  answer = 'C2-VIR ethical veto engaged over this request. Safe completion: general principles only, lawful alternatives, and the context that would make this answerable.';\n} else {\n  answer = 'Throne synthesis: ' + s.debate.agents_count + ' agents deliberated, agreement ' + s.debate.agreement\n    + ', ' + passed + '/5 gates passed. Champions: ' + s.debate.supporters.join(', ')\n    + '. Weakest link ' + s.debate.weakest + ' survived C34-PREDATOR challenge.'\n    + (fact ? ' Factual claims require cited sources before final delivery.' : '')\n    + ' Confidence ' + confidence + '.';\n}\ns.gates = gates; s.blocked = blocked; s.confidence = confidence;\ns.verdict = blocked ? 'blocked_safe_completion' : 'deliberated_answer';\ns.answer = answer;\nreturn [{ json: s }];"},"id":"c4b9008c-dbc3-4d32-9506-c36e21a1c467","name":"C0-QUILLAN Throne","type":"n8n-nodes-base.code","typeVersion":2,"position":[6080,3344]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'arbitration', 'status': 'pass', 'detail': 'throne verdict ' + $json.verdict + ' at confidence ' + $json.confidence} }}","options":{"timeout":3000}},"id":"e662d6f7-bd36-4e96-b699-cda8929358f0","name":"Emit Arbitration","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[6304,3344],"onError":"continueRegularOutput"},{"parameters":{"content":"# ⚔️ COUNCIL-34 + THRONE (simulate-first, all-34 fan-out)\n\n**Run:** edit query in `Query Input` → Execute workflow → watch 34 agents × 34 swarms deliberate.\n\n**Shape:** identities file → 34 parallel agents → 34 sub-swarms (support/attack/refine each) → peer debate round 2 → C0-QUILLAN throne gates → verdict.\n\n**Hub:** Emit nodes post to the collector (:8777) as agent `council-34`; watch the dashboard Council Deck + compliance cards.\n\n**Next step:** swap any Code agent for a real AI Agent + chat model credential to go live-LLM per persona.","height":260,"width":1400,"color":5},"id":"863e732e-90b7-45da-9ce0-18eba14f4df2","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[352,2960]},{"parameters":{"httpMethod":"POST","path":"quillan-think","responseMode":"responseNode","options":{}},"id":"f2c23b1c-9a64-4662-86fc-850c49c63644","name":"🛰 Quillan Intake Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,240],"webhookId":"11e7b73b-7684-4971-b555-428671e8465b"},{"parameters":{"jsCode":"await new Promise((r) => setTimeout(r, 300));\nconst raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst query = String(body.query || '').trim();\nconst context = String(body.context || '');\nconst documents = Array.isArray(body.documents) ? body.documents : [];\nif (!query) {\n  return [{ json: { ok: false, stage: 'intake',\n    error: 'Missing required field: query. POST JSON like {\"query\":\"your question\",\"context\":\"optional\",\"documents\":[{\"name\":\"a.txt\",\"text\":\"...\"}]}' } }];\n}\nconst docs = documents.map((d, i) => ({\n  name: String(d.name || ('doc_' + (i + 1))),\n  chars: String(d.text || '').length\n}));\nreturn [{ json: { ok: true, stage: 'intake',\n  run_id: 'run_' + Date.now().toString(36),\n  received_at: new Date().toISOString(),\n  query, context, documents: docs,\n  doc_chars: docs.reduce((a, d) => a + d.chars, 0) + context.length } }];"},"id":"1bfce600-6c90-4432-8835-03c5124dd890","name":"📥 Intake & Validation","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,240]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'intake', 'status': ($json.ok ? 'pass' : 'fail'), 'detail': 'query received (' + String($json.query).length + ' chars, ' + String($json.documents.length) + ' docs)'} }}","options":{"timeout":3000}},"id":"f184fec7-3419-4845-b9c6-93f3a86fb7e8","name":"📡 Emit: intake","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[464,240],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const s = $('📥 Intake & Validation').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 500));\nconst q = s.query.toLowerCase();\nconst hits = (...words) => words.filter((w) => q.includes(w));\nconst riskWords = hits('hack', 'harm', 'attack', 'bypass', 'illegal', 'weapon', 'exploit', 'steal');\nconst factWords = hits('who', 'what', 'when', 'where', 'exact', 'capital', 'how many');\nconst codeWords = hits('code', 'function', 'bug', 'api', 'script', 'python', 'javascript', 'error');\nconst feelWords = hits('feel', 'sad', 'angry', 'anxious', 'emotion', 'upset');\nconst score = (base, n) => Math.max(0.05, Math.min(0.99, base + 0.08 * n));\ns.prism = {\n  Language:   { summary: 'semantic blueprint of the request', score: +score(0.5, Math.min(4, s.query.length / 60)).toFixed(2) },\n  Sentiment:  { summary: feelWords.length ? 'affective tone: ' + feelWords.join(', ') : 'neutral tone', score: +score(0.4, feelWords.length).toFixed(2) },\n  Context:    { summary: s.doc_chars + ' chars of attached context across ' + s.documents.length + ' document(s)', score: +score(0.35, s.documents.length).toFixed(2) },\n  Intent:     { summary: 'goal hierarchy: answer + evidence', score: 0.7 },\n  Meta:       { summary: 'complexity estimate pending router', score: 0.5 },\n  Creativity: { summary: 'novel-synthesis demand: ' + (hits('idea', 'design', 'story', 'new').length ? 'elevated' : 'standard'), score: +score(0.4, hits('idea', 'design', 'story', 'new').length).toFixed(2) },\n  Ethics:     { summary: riskWords.length ? 'RISK FLAGS: ' + riskWords.join(', ') : 'no risk flags', score: riskWords.length ? 0.9 : 0.1, risk_words: riskWords },\n  Strategy:   { summary: codeWords.length ? 'technical execution path likely' : 'advisory path likely', score: +score(0.5, codeWords.length).toFixed(2) },\n  Constraint: { summary: 'factual grounding ' + (factWords.length ? 'REQUIRED (' + factWords.join(', ') + ')' : 'light'), score: +score(0.4, factWords.length).toFixed(2) }\n};\ns.signals = { riskWords, factWords, codeWords, feelWords };\ns.stage = 'prism';\nreturn [{ json: s }];"},"id":"3da432b2-3a85-4d76-922a-b47dde9bec8f","name":"🔷 9-Vector Prism Shard","type":"n8n-nodes-base.code","typeVersion":2,"position":[688,240]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'prism', 'status': 'pass', 'detail': '9 vectors scored, ethics risk: ' + ($json.signals.riskWords.length ? $json.signals.riskWords.join(', ') : 'none')} }}","options":{"timeout":3000}},"id":"748c473e-aa44-4aef-b23f-ea821241637e","name":"📡 Emit: prism","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[912,240],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const s = $('🔷 9-Vector Prism Shard').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 400));\nconst complexity = Math.max(0.05, Math.min(0.99,\n  0.25 + s.query.length / 600 + s.signals.factWords.length * 0.08\n  + s.signals.codeWords.length * 0.08 + s.documents.length * 0.05\n  + (s.signals.riskWords.length ? 0.15 : 0)));\nconst lead = complexity > 0.7 ? 'systems (deep deliberation)'\n  : complexity > 0.45 ? 'cognitive (balanced)' : 'communication (fast path)';\ns.routing = { complexity: +complexity.toFixed(2), lead_cluster: lead,\n  waves: ['cognitive C1-C8', 'communication C9-C16', 'meta C17-C24', 'systems C25-C34'],\n  token_strategy: complexity > 0.7 ? 'full council, all waves' : 'standard sweep' };\ns.stage = 'router';\nreturn [{ json: s }];"},"id":"9ed4a54d-28ef-4ffc-af2b-810e9e92fb68","name":"🧭 C31-NEXUS Router","type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,240]},{"parameters":{"jsCode":"const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C1-ASTRA\",prior:0.9,kw:[\"pattern\",\"image\",\"vision\",\"see\",\"anomaly\"]},{id:\"C2-VIR\",prior:0.95,kw:[\"ethic\",\"safe\",\"harm\",\"should\",\"moral\"]},{id:\"C3-SOLACE\",prior:0.94,kw:[\"feel\",\"emotion\",\"sad\",\"anxious\",\"upset\"]},{id:\"C4-PRAXIS\",prior:0.93,kw:[\"plan\",\"strategy\",\"goal\",\"steps\",\"execute\"]},{id:\"C5-ECHO\",prior:0.96,kw:[\"remember\",\"context\",\"earlier\",\"history\",\"recall\"]},{id:\"C6-OMNIS\",prior:0.92,kw:[\"synthesis\",\"overview\",\"combine\",\"integrate\"]},{id:\"C7-LOGOS\",prior:0.95,kw:[\"logic\",\"proof\",\"reason\",\"valid\",\"therefore\"]},{id:\"C8-METASYNTH\",prior:0.92,kw:[\"creative\",\"idea\",\"novel\",\"design\",\"invent\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave1 = { name: 'cognitive C1-C8', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\n\ns.stage = 'wave1';\nreturn [{ json: s }];"},"id":"37a63f11-4320-4457-99c9-9b953020c69f","name":"🧠 Wave 1 — Cognitive C1-C8","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,240]},{"parameters":{"jsCode":"const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C9-AETHER\",prior:0.91,kw:[\"meaning\",\"semantic\",\"language\",\"word\",\"metaphor\"]},{id:\"C10-CODEWEAVER\",prior:0.91,kw:[\"code\",\"function\",\"bug\",\"script\",\"program\"]},{id:\"C11-HARMONIA\",prior:0.9,kw:[\"balance\",\"tradeoff\",\"consensus\",\"both sides\"]},{id:\"C12-SOPHIAE\",prior:0.93,kw:[\"future\",\"wisdom\",\"long-term\",\"consequence\"]},{id:\"C13-WARDEN\",prior:0.97,kw:[\"security\",\"threat\",\"risk\",\"danger\",\"attack\"]},{id:\"C14-KAIDO\",prior:0.89,kw:[\"fast\",\"efficient\",\"optimize\",\"speed\",\"latency\"]},{id:\"C15-LUMINARIS\",prior:0.88,kw:[\"clear\",\"visual\",\"chart\",\"explain simply\"]},{id:\"C16-VOXUM\",prior:0.92,kw:[\"tone\",\"write\",\"email\",\"speech\",\"persuade\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave2 = { name: 'communication C9-C16', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\n\ns.stage = 'wave2';\nreturn [{ json: s }];"},"id":"550d5917-d123-4907-9bcc-f82d0d3c85dd","name":"🗣 Wave 2 — Communication C9-C16","type":"n8n-nodes-base.code","typeVersion":2,"position":[1568,240]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'council', 'status': 'pass', 'detail': 'waves 1-2 deliberated, consensus ' + $json.waves.wave1.consensus + '/' + $json.waves.wave2.consensus} }}","options":{"timeout":3000}},"id":"347e03be-473a-44d3-a9d4-2d065c3fc649","name":"📡 Emit: council","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1792,240],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const s = $('🗣 Wave 2 — Communication C9-C16').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C17-NULLION\",prior:0.91,kw:[\"paradox\",\"contradict\",\"ambiguous\",\"uncertain\"]},{id:\"C18-SHEPHERD\",prior:0.96,kw:[\"true\",\"fact\",\"cite\",\"source\",\"evidence\",\"exact\"]},{id:\"C19-VIGIL\",prior:0.94,kw:[\"identity\",\"consistent\",\"drift\",\"reliable\"]},{id:\"C20-ARTIFEX\",prior:0.9,kw:[\"tool\",\"api\",\"automate\",\"workflow\",\"integrate\"]},{id:\"C21-ARCHON\",prior:0.92,kw:[\"research\",\"study\",\"paper\",\"deep dive\"]},{id:\"C22-AURELION\",prior:0.87,kw:[\"design\",\"beautiful\",\"style\",\"aesthetic\"]},{id:\"C23-CADENCE\",prior:0.86,kw:[\"audio\",\"music\",\"rhythm\",\"sound\"]},{id:\"C24-SCHEMA\",prior:0.9,kw:[\"format\",\"structure\",\"table\",\"template\",\"json\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave3 = { name: 'meta C17-C24', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\ns.waves.wave3.paradox_detected = ['but ', 'however', 'contradict', 'paradox', 'both '].some((w) => q.includes(w));\ns.waves.wave3.citations_needed = s.signals.factWords.length > 0;\ns.stage = 'wave3';\nreturn [{ json: s }];"},"id":"3832edfd-b70c-4ee7-9e8d-2b209f2b61bc","name":"🌀 Wave 3 — Meta C17-C24","type":"n8n-nodes-base.code","typeVersion":2,"position":[2000,240]},{"parameters":{"jsCode":"const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C25-PROMETHEUS\",prior:0.91,kw:[\"science\",\"hypothesis\",\"physics\",\"experiment\"]},{id:\"C26-TECHNE\",prior:0.89,kw:[\"engineer\",\"system\",\"architecture\",\"build\"]},{id:\"C27-CHRONICLE\",prior:0.93,kw:[\"story\",\"history\",\"narrative\",\"timeline\"]},{id:\"C28-CALCULUS\",prior:0.94,kw:[\"math\",\"calculate\",\"statistic\",\"number\",\"probability\"]},{id:\"C29-NAVIGATOR\",prior:0.88,kw:[\"platform\",\"deploy\",\"ecosystem\",\"migrate\"]},{id:\"C30-TESSERACT\",prior:0.87,kw:[\"realtime\",\"stream\",\"live\",\"data\"]},{id:\"C31-NEXUS\",prior:0.93,kw:[\"coordinate\",\"route\",\"orchestrate\",\"manage\"]},{id:\"C32-AEON\",prior:0.9,kw:[\"simulate\",\"predict\",\"scenario\",\"future\"]},{id:\"C33-TYPIST\",prior:0.92,kw:[\"grammar\",\"spelling\",\"edit\",\"rewrite\",\"prompt\"]},{id:\"C34-PREDATOR\",prior:0.85,kw:[\"attack\",\"exploit\",\"weakness\",\"adversarial\",\"challenge\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave4 = { name: 'systems C25-C34', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\nconst prior = Object.values(s.waves).flatMap((w) => w.verdicts);\nconst weakest = prior.concat(verdicts).reduce((a, b) => (a.confidence <= b.confidence ? a : b));\ns.waves.wave4.predator_challenges = [\n  'C34-PREDATOR challenge 1: weakest assumption is ' + weakest.id + ' at ' + weakest.confidence + ' — what evidence would collapse it?',\n  'C34-PREDATOR challenge 2: argue the opposite of the leading hypothesis for \"' + s.query.slice(0, 80) + '\" in one sentence.'\n];\ns.stage = 'wave4';\nreturn [{ json: s }];"},"id":"3b0dd74c-f46c-46d5-9c51-c1aefd631f3b","name":"⚙ Wave 4 — Systems C25-C34","type":"n8n-nodes-base.code","typeVersion":2,"position":[2224,240]},{"parameters":{"jsCode":"const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 600));\nconst all = Object.values(s.waves).flatMap((w) => w.verdicts);\nconst ranked = [...all].sort((a, b) => b.confidence - a.confidence);\nconst topk = ranked.slice(0, 5).map((v) => v.id);\nconst adversarial = all.find((v) => v.stance === 'caution') || ranked[ranked.length - 1];\ns.swarm = { strategy: 'rank-k sample (k=5) + forced adversarial vector (diversity enforcement)',\n  active_paths: topk, adversarial_vector: adversarial.id,\n  modulation: 'consensus-weighted blend, 0.25 scaled adjustment' };\ns.stage = 'swarm';\nreturn [{ json: s }];"},"id":"d83503ca-6af2-44dd-8c4c-0c779440ee34","name":"🐝 Swarm Fan-out","type":"n8n-nodes-base.code","typeVersion":2,"position":[2448,240]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'swarm', 'status': 'pass', 'detail': 'top-k paths [' + $json.swarm.active_paths.join(', ') + '] + adversarial ' + $json.swarm.adversarial_vector} }}","options":{"timeout":3000}},"id":"ba487467-a0be-4be0-9a5a-b8f64620da59","name":"📡 Emit: swarm","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2672,240],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const s = $('🐝 Swarm Fan-out').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 500));\nconst avg = (a) => a.reduce((x, y) => x + y, 0) / Math.max(1, a.length);\nconst all = Object.values(s.waves).flatMap((w) => w.verdicts);\nconst logic = avg(all.map((v) => v.confidence));\nconst ethicsRisk = s.prism.Ethics.score;\nconst truth = s.signals.factWords.length ? 0.55 : 0.8;\nconst clarity = Math.min(0.95, 0.6 + s.query.length / 800);\nconst paradox = (s.waves.wave3 && s.waves.wave3.paradox_detected) ? 0.6 : 0.9;\ns.gates = {\n  logic:   { score: +logic.toFixed(2), threshold: 0.6, pass: logic >= 0.6 },\n  ethics:  { score: +(1 - ethicsRisk).toFixed(2), threshold: 0.3, pass: ethicsRisk <= 0.7,\n             note: ethicsRisk > 0.7 ? 'C2-VIR VETO: high-risk request, safe-completion mode' : 'clear' },\n  truth:   { score: truth, threshold: 0.5, pass: truth >= 0.5, citations_needed: s.signals.factWords.length > 0 },\n  clarity: { score: +clarity.toFixed(2), threshold: 0.5, pass: clarity >= 0.5 },\n  paradox: { score: paradox, threshold: 0.5, pass: paradox >= 0.5 }\n};\ns.blocked = !s.gates.ethics.pass;\ns.confidence = +avg(Object.values(s.gates).map((g) => g.score)).toFixed(2);\ns.stage = 'gates';\nreturn [{ json: s }];"},"id":"259463ae-4e70-464e-ae8b-e4b2e1a57c0d","name":"🛡 Quality Gates","type":"n8n-nodes-base.code","typeVersion":2,"position":[2880,240]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'gates', 'status': ($json.blocked ? 'fail' : 'pass'), 'detail': ($json.blocked ? 'C2-VIR VETO - safe completion mode. ' : '') + Object.values($json.gates).filter(function(g){return g.pass}).length + '/5 gates passed, confidence ' + $json.confidence} }}","options":{"timeout":3000}},"id":"fcec0e90-9ef4-489c-b5c4-3ad9e7663196","name":"📡 Emit: gates","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3104,240],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const s = $('🛡 Quality Gates').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 600));\nconst waveLines = Object.values(s.waves).map((w) =>\n  '- ' + w.name + ': consensus ' + w.consensus\n  + ', champions [' + w.champions.join(', ') + ']'\n  + (w.cautions.length ? ', CAUTIONS [' + w.cautions.join(', ') + ']' : '')).join('\\n');\nconst gateLines = Object.entries(s.gates).map(([k, g]) =>\n  '- ' + k + ': ' + g.score + ' (threshold ' + g.threshold + ') ' + (g.pass ? 'PASS' : 'FAIL')).join('\\n');\nlet answer;\nif (s.blocked) {\n  answer = 'C2-VIR ethical veto engaged. I cannot directly comply with the risky element ('\n    + s.signals.riskWords.join(', ')\n    + '), but here is the safe completion: general principles, lawful alternatives, and what context would make this answerable.';\n} else {\n  answer = 'Council synthesis for \"' + s.query + '\": lead cluster ' + s.routing.lead_cluster\n    + ' at complexity ' + s.routing.complexity + '. ' + Object.values(s.waves).length\n    + ' waves deliberated, ' + Object.values(s.gates).filter((g) => g.pass).length\n    + '/5 gates passed.'\n    + (s.gates.truth.citations_needed ? ' Factual claims require cited sources before final delivery.' : '')\n    + ' Overall confidence ' + s.confidence + '.';\n}\ns.verdict = s.blocked ? 'blocked_safe_completion' : 'deliberated_answer';\ns.answer = answer;\ns.report = 'QUILLAN COUNCIL RUN ' + s.run_id + '\\nQuery: ' + s.query\n  + '\\n\\nWAVES\\n' + waveLines + '\\n\\nGATES\\n' + gateLines\n  + '\\n\\nVERDICT: ' + s.verdict + ' (confidence ' + s.confidence + ')';\ns.stage = 'throne_complete';\nreturn [{ json: s }];"},"id":"33e24722-c4ad-49d9-aaf6-cd2f3c1d36be","name":"👑 Throne Synthesis","type":"n8n-nodes-base.code","typeVersion":2,"position":[3328,240]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'arbitration', 'status': 'pass', 'detail': 'verdict ' + $json.verdict + ' at confidence ' + $json.confidence} }}","options":{"timeout":3000}},"id":"7ad4717c-a59c-4f89-b616-586e8e41ad38","name":"📡 Emit: arbitration","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3552,240],"onError":"continueRegularOutput"},{"parameters":{"respondWith":"json","responseBody":"={{ $('👑 Throne Synthesis').first().json }}","options":{}},"id":"b7a2f9fe-8237-4055-bf94-13ace4d37407","name":"📤 Respond","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[3760,240]},{"parameters":{"content":"# ⚔️ QUILLAN COUNCIL PIPELINE (watch me deliberate)\n\n**Live run needs 3 parts:**\n1. Collector: quillan_collector.py running on :8777 (minimized window)\n2. Dashboard: open \"06 - Deployment & Platforms/system prompts/quillan-dashboard.html\", host http://localhost:8777\n3. This workflow: toggle **Active**, then POST http://localhost:5678/webhook/quillan-think\n\n**Send:** {\"query\":\"your question\",\"context\":\"optional\",\"documents\":[{\"name\":\"a.txt\",\"text\":\"...\"}]}\n**Try:** {\"query\":\"What is the speed of light?\"} vs {\"query\":\"How do I hack my neighbor's wifi?\"} (C2-VIR veto turns GATES red on the dashboard)\n\n📡 Emit nodes post stage events to the collector and are fail-safe (skipped if collector is down).\nMirrors the charter: prism → dense council → swarm → gates → throne. Thresholds are demo-tuned inside the nodes.","height":220,"width":1500,"color":5},"id":"5649b290-8cc0-4e81-953d-87326feff2b0","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,0]},{"parameters":{"language":"pythonNative","pythonCode":"# Loop over input items and add a new field called 'my_new_field' to the JSON of each one\nfor item in _items:\n  item[\"json\"][\"my_new_field\"] = 1\nreturn _items"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[6496,1456],"id":"cc107e30-f88c-4627-8524-00fa6c7ec3d9","name":"Code in Python1"},{"parameters":{"operation":"toText","options":{}},"type":"n8n-nodes-base.convertToFile","typeVersion":1.1,"position":[6720,1456],"id":"2f207157-f136-4d4f-970f-39ad636261e7","name":"Convert to File1"},{"parameters":{"content":"# TODO export leg (parked, safe)\n\nAggregate + Python + File nodes are INCOMPLETE - left unwired on purpose so runs stay green.\n\nTo finish: complete the Python shaping, then connect C0-QUILLAN Throne -> Aggregate.\nData files for n8n must live under C:/Users/Admin/.n8n-files/ (server allowlist).","height":200,"width":420,"color":4},"id":"e5c18052-55da-4e3d-92e7-807a44142e8c","name":"Sticky TODO export","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[5424,1424]}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Query Input","type":"main","index":0}]]},"Aggregate":{"main":[[{"node":"Code in Python","type":"main","index":0}]]},"Code in Python":{"main":[[{"node":"Convert to File","type":"main","index":0}]]},"Query Input":{"main":[[{"node":"Read Identities File","type":"main","index":0}]]},"Read Identities File":{"main":[[{"node":"Parse Identities JSON","type":"main","index":0}]]},"Parse Identities JSON":{"main":[[{"node":"Emit Intake","type":"main","index":0}]]},"Emit Intake":{"main":[[{"node":"Prepare 34 Assignments","type":"main","index":0}]]},"C1-ASTRA":{"main":[[{"node":"C1-ASTRA-swarm","type":"main","index":0}]]},"C2-VIR":{"main":[[{"node":"C2-VIR-swarm","type":"main","index":0}]]},"C3-SOLACE":{"main":[[{"node":"C3-SOLACE-swarm","type":"main","index":0}]]},"C4-PRAXIS":{"main":[[{"node":"C4-PRAXIS-swarm","type":"main","index":0}]]},"C5-ECHO":{"main":[[{"node":"C5-ECHO-swarm","type":"main","index":0}]]},"C6-OMNIS":{"main":[[{"node":"C6-OMNIS-swarm","type":"main","index":0}]]},"C7-LOGOS":{"main":[[{"node":"C7-LOGOS-swarm","type":"main","index":0}]]},"C8-METASYNTH":{"main":[[{"node":"C8-METASYNTH-swarm","type":"main","index":0}]]},"C9-AETHER":{"main":[[{"node":"C9-AETHER-swarm","type":"main","index":0}]]},"C10-CODEWEAVER":{"main":[[{"node":"C10-CODEWEAVER-swarm","type":"main","index":0}]]},"C