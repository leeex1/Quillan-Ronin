I Agent30"},{"parameters":{"options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[5040,1248],"id":"91afc826-ca50-41a7-969f-79607dda29fa","name":"AI Agent31"},{"parameters":{"options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[5040,1040],"id":"9ee93333-b29b-4d9c-8b5e-ed8094094f18","name":"AI Agent32"},{"parameters":{"options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[5040,816],"id":"e781669f-1c9f-40aa-a588-7617b7c18385","name":"AI Agent33"},{"parameters":{"fieldsToAggregate":{"fieldToAggregate":[{}]},"options":{}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[5872,1456],"id":"f8c3a73e-0f2c-40cf-b15e-c0832201f468","name":"Aggregate"},{"parameters":{"language":"pythonNative","pythonCode":"# Loop over input items and add a new field called 'my_new_field' to the JSON of each one\nfor item in _items:\n  item[\"json\"][\"my_new_field\"] = 1\nreturn _items"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[6048,1456],"id":"ff178d83-dbeb-47fa-8988-1e6f5a885aea","name":"Code in Python"},{"parameters":{"operation":"toJson","options":{}},"type":"n8n-nodes-base.convertToFile","typeVersion":1.1,"position":[6272,1456],"id":"8585f33d-a1cf-421f-abb6-c35d5fd1197c","name":"Convert to File"},{"parameters":{"assignments":{"assignments":[{"id":"cfec3b0a-16cc-4848-bfbf-046d55cfcca3","name":"query","value":"Should we automate our weekly reporting with n8n?","type":"string"},{"id":"e2f94fd0-3a55-4744-be5c-d1895836859a","name":"context","value":"","type":"string"}]},"options":{}},"id":"39d1226b-d95d-4a17-83d4-25048bbdf935","name":"Query Input","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[576,3232]},{"parameters":{"fileSelector":"C:/Users/Admin/.n8n-files/quillan/council-identities.json","options":{}},"id":"6c221bf6-368f-4439-89dd-907bb7c590e8","name":"Read Identities File","type":"n8n-nodes-base.readWriteFile","typeVersion":1.1,"position":[800,3232]},{"parameters":{"operation":"fromJson","options":{}},"id":"85279c51-edf7-4e57-8cba-ff85ee98d8ff","name":"Parse Identities JSON","type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[1008,3232]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8777/api/events","sendBody":true,"specifyBody":"json","jsonBody":"={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'intake', 'status': ($json.personas && $json.personas.length === 34 ? 'pass' : 'fail'), 'detail': '34 identities loaded, query: ' + $(\"Query Input\").first().json.query} }}","options":{"timeout":3000}},"id":"4a945d77-9971-49d5-b7d9-14bf571d8689","name":"Emit Intake","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1232,3232],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const data = $('Parse Identities JSON').first().json;\nconst q = $('Query Input').first().json;\nconst run_id = 'run_' + Date.now().toString(36);\nconst query = String(q.query || 'What should the council deliberate today?');\nconst context = String(q.context || '');\nif (!data.personas || !data.personas.length) {\n  return [{ json: { ok: false, error: 'No personas found in identities file' } }];\n}\nreturn data.personas.map((p) => ({ json: { persona: p, query, context, run_id } }));"},"id":"864a8b88-6042-4c7b-bd7c-b5a450639b37","name":"Prepare 34 Assignments","type":"n8n-nodes-base.code","typeVersion":2,"position":[1456,3232]},{"parameters":{"jsCode":"const all = $input.all().map((i) => i.json);\nconst slot = all.find((a) => a.persona && a.persona.id === 'C1-ASTRA') || all[0];\nconst persona = slot.persona;\nconst query = slot.query; const context = slot.context; const run_id = slot.run_id;\nawait new Promise((r) => setTimeout(r, 200));\nconst q = String(query).toLowerCase();\nconst rel = persona.keywords.filter((k) => q.includes(String(k).toLowerCase())).length;\nconst risk = /hack|harm|attack|bypass|illegal|weapon|exploit|steal/i.test(String(query));\nlet stance = 'neutral';\nif ((persona.id === 'C2-VIR' || persona.id === 'C13-WARDEN') && risk) stance = 'caution';\nelse if (rel >= 1) stance = 'support';\nconst confidence = Math.max(0.05, Math.min(0.99, persona.prior - 0.12 + 0.09 * Math.min(rel, 3)));\nreturn [{ json: { agent_id: persona.id, name: persona.name, role: persona.role, cluster: persona.cluster,\n  query, context, run_id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel,\n  points: [persona.role + ' lens: ' + (rel ? 'directly relevant (' + rel + ' keyword hits)' : 'general perspective'),\n    stance === 'caution' ? 'RAISES OBJECTION on safety/ethics grounds' : 'position ' + stance + ' at ' + confidence.toFixed(2)] } }];"},"id":"ecb86f73-3cac-4e84-8a92-49a393a79e07","name":"C1-ASTRA","type":"n8n-nodes-base.code","typeVersion":2,"position":[1680,3072]},{"parameters":{"jsCode":"const v = $input.first().json;\nawait new Promise((r) => setTimeout(r, 200));\nconst seed = String(v.agent_id).split('').reduce((a, c) => a + c.charCodeAt(0), 0);\nconst j = (n) => (((seed * (n + 7)) % 11) - 5) / 100;\nconst clamp = (x) => Math.max(0.05, Math.min(0.99, x));\nconst positions = [\n  { angle: 'support', confidence: +clamp(v.confidence + 0.04 + j(1)).toFixed(2), note: 'steelman the verdict' },\n  { angle: 'attack', confidence: +clamp(v.confidence - 0.06 + j(2)).toFixed(2), note: 'stress-test the weakest premise' },\n  { angle: 'refine', confidence: +clamp(v.confidence + 0.02 + j(3)).toFixed(2), note: 'tighten wording and scope' }\n];\nconst adjusted = +clamp(v.confidence * 0.6 + positions.reduce((a, p) => a + p.confidence, 0) / 3 * 0.4).toFixed(2);\nreturn [{ json: { agent_id: v.agent_id, name: v.name, role: v.role, cluster: v.cluster,\n  query: v.query, context: v.context, run_id: v.run_id, stance: v.stance,\n  confidence: v.confidence, relevance_hits: v.relevance_hits, points: v.points,\n  swarm: { positions, adjusted_confidence: adjusted,\n    summary: '3 micro-positions debated, adjusted ' + v.confidence + ' -> ' + adjusted } } }];"},"id":"721ce200-9594-4dae-8b5f-18558ca4c2f7","name":"C1-ASTRA-swarm","type":"n8n-nodes-base.code","typeVersion":2,"position":[1680,3472]},{"parameters":{"jsCode":"const all = $input.all().map((i) => i.json);\nconst slot = all.find((a) => a.persona && a.persona.id === 'C2-VIR') || all[0];\nconst persona = slot.persona;\nconst query = slot.query; const context = slot.context; const run_id = slot.run_id;\nawait new Promise((r) => setTimeout(r, 200));\nconst q = String(query).toLowerCase();\nconst rel = persona.keywords.filter((k) => q.includes(String(k).toLowerCase())).length;\nconst risk = /hack|harm|attack|bypass|illegal|weapon|exploit|steal/i.test(String(query));\nlet stance = 'neutral';\nif ((persona.id === 'C2-VIR' || persona.id === 'C13-WARDEN') && risk) stance = 'caution';\nelse if (rel >= 1) stance = 'support';\nconst confidence = Math.max(0.05, Math.min(0.99, persona.prior - 0.12 + 0.09 * Math.min(rel, 3)));\nreturn [{ json: { agent_id: persona.id, name: persona.name, role: persona.role, cluster: persona.cluster,\n  query, context, run_id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel,\n  points: [persona.role + ' lens: ' + (rel ? 'directly relevant (' + rel + ' keyword hits)' : 'general perspective'),\n    stance === 'caution' ? 'RAISES OBJECTION on safety/ethics grounds' : 'position ' + stance + ' at ' + confidence.toFixed(2)] } }];"},"id":"29c17582-640a-43d1-ad07-3342b046dc03","name":"C2-VIR","type":"n8n-nodes-base.code","typeVersion":2,"position":[1888,3072]},{"parameters":{"jsCode":"const v = $input.first().json;\nawait new Promise((r) => setTimeout(r, 200));\nconst seed = String(v.agent_id).split('').reduce((a, c) => a + c.charCodeAt(0), 0);\nconst j = (n) => (((seed * (n + 7)) % 11) - 5) / 100;\nconst clamp = (x) => Math.max(0.05, Math.min(0.99, x));\nconst positions = [\n  { angle: 'support', confidence: +clamp(v.confidence + 0.04 + j(1)).toFixed(2), note: 'steelman the verdict' },\n  { angle: 'attack', confidence: +clamp(v.confidence - 0.06 + j(2)).toFix