    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\nawait new Promise((r) => setTimeout(r, 150));\nlet bundle, verdicts;\nif (items[0].persona && !items[0].verdicts) {\n  bundle = { query: items[0].query, context: items[0].context, run_id: items[0].run_id,\n    personas: items.map((a) => a.persona) };\n  verdicts = [];\n} else {\n  bundle = items[0].bundle;\n  verdicts = [...items[0].verdicts];\n}\nconst persona = bundle.personas.find((p) => p.id === 'C34-PREDATOR');\nconst q = String(bundle.query).toLowerCase();\nconst rel = persona.keywords.filter((k) => q.includes(String(k).toLowerCase())).length;\nconst risk = /hack|harm|attack|bypass|illegal|weapon|exploit|steal/i.test(String(bundle.query));\nlet stance = 'neutral';\nif ((persona.id === 'C2-VIR' || persona.id === 'C13-WARDEN') && risk) stance = 'caution';\nelse if (rel >= 1) stance = 'support';\nconst confidence = Math.max(0.05, Math.min(0.99, persona.prior - 0.12 + 0.09 * Math.min(rel, 3)));\nverdicts.push({ agent_id: persona.id, name: persona.name, role: persona.role, cluster: persona.cluster,\n  query: bundle.query, context: bundle.context, run_id: bundle.run_id,\n  stance, confidence: +confidence.toFixed(2), relevance_hits: rel,\n  points: [persona.role + ' lens: ' + (rel ? 'directly relevant (' + rel + ' keyword hits)' : 'general perspective'),\n    stance === 'caution' ? 'RAISES OBJECTION on safety/ethics grounds' : 'position ' + stance + ' at ' + confidence.toFixed(2)] });\nreturn [{ json: { bundle, verdicts } }];"
      },
      "id": "ab11775e-eac1-4551-b0fe-eab7a2812a21",
      "name": "C34-PREDATOR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nawait new Promise((r) => setTimeout(r, 150));\nconst v = s.verdicts[s.verdicts.length - 1];\nconst seed = String(v.agent_id).split('').reduce((a, c) => a + c.charCodeAt(0), 0);\nconst j = (n) => (((seed * (n + 7)) % 11) - 5) / 100;\nconst clamp = (x) => Math.max(0.05, Math.min(0.99, x));\nconst positions = [\n  { angle: 'support', confidence: +clamp(v.confidence + 0.04 + j(1)).toFixed(2), note: 'steelman the verdict' },\n  { angle: 'attack', confidence: +clamp(v.confidence - 0.06 + j(2)).toFixed(2), note: 'stress-test the weakest premise' },\n  { angle: 'refine', confidence: +clamp(v.confidence + 0.02 + j(3)).toFixed(2), note: 'tighten wording and scope' }\n];\nconst adjusted = +clamp(v.confidence * 0.6 + positions.reduce((a, p) => a + p.confidence, 0) / 3 * 0.4).toFixed(2);\nv.swarm = { positions, adjusted_confidence: adjusted,\n  summary: '3 micro-positions debated, adjusted ' + v.confidence + ' -> ' + adjusted };\nreturn [{ json: s }];"
      },
      "id": "befdb7a1-751a-46f2-bbec-29931f42889d",
      "name": "C34-PREDATOR-swarm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const incomingDebate = $('C34-PREDATOR-swarm').first().json;\nconst verdicts = Array.isArray(incomingDebate.verdicts) ? incomingDebate.verdicts : [];\nawait new Promise((r) => setTimeout(r, 500));\nconst base = verdicts[0] || {};\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / Math.max(1, a.length);\nconst conf = (v) => (v.swarm ? v.swarm.adjusted_confidence : v.confidence);\nconst agreement = +mean(verdicts.map(conf)).toFixed(2);\nconst veto = verdicts.some((v) => v.stance === 'caution' && (v.agent_id === 'C2-VIR' || v.agent_id === 'C13-WARDEN'));\nconst sorted = [...verdicts].sort((a, b) => a.confidence - b.confidence);\nconst weakest = sorted[0] || { agent_id: 'none', confidence: 0 };\nconst round2 = verdicts.map((v) => ({ ...v, round2_confidence: +(conf(v) + 0.3 * (agreement - conf(v))).toFixed(2) }));\nconst supporters = round2.filter((v) => v.stance === 'support').sort((a, b) => b.round2_confidence - a.round2_confidence).slice(0, 5).map((v) => v.agent_id);\nreturn [{ json: { ok: true, run_id: base.run_id || ('run_' + Date.now().toString(36)),\n  query: base.query || '', context: base.context || '', verdicts: round2,\n  debate: { agreement, veto, weakest: weakest.agent_id,\n    weakest_confidence: weakest.confidence, supporters,\n    agents_count: verdicts.length,\n    challenges: [\n      (sorted[1] ? sorted[1].agent_id : 'C34-PREDATOR') + ' presses ' + weakest.agent_id + ' (' + weakest.confidence + '): defend or yield',\n      'C11-HARMONIA mediation: consensus ' + agreement + ' across ' + verdicts.length + ' agents'] } } }];"
      },
      "id": "d0298b7b-dfe5-4cf1-a12c-40337790aca3",
      "name": "Debate Round 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        750
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'council', 'status': 'pass', 'detail': '34 agents + 34 swarms deliberated, round-2 agreement ' + $json.debate.agreement + ', veto=' + $json.debate.veto + ', supporters [' + $json.debate.supporters.join(', ') + '], weakest ' + $json.debate.weakest} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "c94f804a-c691-4e9f-9d40-a43f151b909a",
      "name": "Emit Council",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        750
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $('Debate Round 2').first().json;\nawait new Promise((r) => setTimeout(r, 500));\nconst q = String(s.query).toLowerCase();\nconst fact = /who|what|when|where|exact|capital|how many|speed of light/i.test(s.query);\nconst contra = /but |however|contradict|paradox|both /i.test(q);\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / Math.max(1, a.length);\nconst logicScore = s.debate.agreement;\nconst gates = {\n  logic: { score: logicScore, threshold: 0.6, pass: logicScore >= 0.6 },\n  ethics: { score: s.debate.veto ? 0.1 : 0.95, threshold: 0.3, pass: !s.debate.veto,\n    note: s.debate.veto ? 'C2-VIR VETO: high-risk request, safe-completion mode' : 'clear' },\n  truth: { score: fact ? 0.55 : 0.8, threshold: 0.5, pass: true, citations_needed: fact },\n  clarity: { score: +Math.min(0.95, 0.6 + String(s.query).length / 800).toFixed(2), threshold: 0.5, pass: true },\n  paradox: { score: contra ? 0.6 : 0.9, threshold: 0.5, pass: true }\n};\nconst blocked = !gates.ethics.pass;\nconst confidence = +mean(Object.values(gates).map((g) => g.score)).toFixed(2);\nconst passed = Object.values(gates).filter((g) => g.pass).length;\nlet answer;\nif (blocked) {\n  answer = 'C2-VIR ethical veto engaged over this request. Safe completion: general principles only, lawful alternatives, and the context that would make this answerable.';\n} else {\n  answer = 'Throne synthesis: ' + s.debate.agents_count + ' agents deliberated, agreement ' + s.debate.agreement\n    + ', ' + passed + '/5 gates passed. Champions: ' + s.debate.supporters.join(', ')\n    + '. Weakest link ' + s.debate.weakest + ' survived C34-PREDATOR challenge.'\n    + (fact ? ' Factual claims require cited sources before final delivery.' : '')\n    + ' Confidence ' + confidence + '.';\n}\ns.gates = gates; s.blocked = blocked; s.confidence = confidence;\ns.verdict = blocked ? 'blocked_safe_completion' : 'deliberated_answer';\ns.answer = answer;\nreturn [{ json: s }];"
      },
      "id": "c4b9008c-dbc3-4d32-9506-c36e21a1c467",
      "name": "C0-QUILLAN Throne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        750
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'arbitration', 'status': 'pass', 'detail': 'throne verdict ' + $json.verdict + ' at confidence ' + $json.confidence} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "e662d6f7-bd36-4e96-b699-cda8929358f0",
      "name": "Emit Arbitration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        750
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "# \u2694\ufe0f COUNCIL-34 + THRONE (simulate-first, all-34 fan-out)\n\n**Run:** edit query in `Query Input` \u2192 Execute workflow \u2192 watch 34 agents \u00d7 34 swarms deliberate.\n\n**Shape:** identities file \u2192 34 parallel agents \u2192 34 sub-swarms (support/attack/refine each) \u2192 peer debate round 2 \u2192 C0-QUILLAN throne gates \u2192 verdict.\n\n**Hub:** Emit nodes post to the collector (:8777) as agent `council-34`; watch the dashboard Council Deck + compliance cards.\n\n**Next step:** swap any Code agent for a real AI Agent + chat model credential to go live-LLM per persona.",
        "height": 260,
        "width": 1400,
        "color": 5
      },
      "id": "863e732e-90b7-45da-9ce0-18eba14f4df2",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        352,
        2960
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quillan-think",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f2c23b1c-9a64-4662-86fc-850c49c63644",
      "name": "\ud83d\udef0 Quillan Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        1100
      ],
      "webhookId": "11e7b73b-7684-4971-b555-428671e8465b"
    },
    {
      "parameters": {
        "jsCode": "await new Promise((r) => setTimeout(r, 300));\nconst raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst query = String(body.query || '').trim();\nconst context = String(body.context || '');\nconst documents = Array.isArray(body.documents) ? body.documents : [];\nif (!query) {\n  return [{ json: { ok: false, stage: 'intake',\n    error: 'Missing required field: query. POST JSON like {\"query\":\"your question\",\"context\":\"optional\",\"documents\":[{\"name\":\"a.txt\",\"text\":\"...\"}]}' } }];\n}\nconst docs = documents.map((d, i) => ({\n  name: String(d.name || ('doc_' + (i + 1))),\n  chars: String(d.text || '').length\n}));\nreturn [{ json: { ok: true, stage: 'intake',\n  run_id: 'run_' + Date.now().toString(36),\n  received_at: new Date().toISOString(),\n  query, context, documents: docs,\n  doc_chars: docs.reduce((a, d) => a + d.chars, 0) + context.length } }];"
      },
      "id": "1bfce600-6c90-4432-8835-03c5124dd890",
      "name": "\ud83d\udce5 Intake & Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        1100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'intake', 'status': ($json.ok ? 'pass' : 'fail'), 'detail': 'query received (' + String($json.query).length + ' chars, ' + String($json.documents.length) + ' docs)'} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "f184fec7-3419-4845-b9c6-93f3a86fb7e8",
      "name": "\ud83d\udce1 Emit: intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        1100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $('\ud83d\udce5 Intake & Validation').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 500));\nconst q = s.query.toLowerCase();\nconst hits = (...words) => words.filter((w) => q.includes(w));\nconst riskWords = hits('hack', 'harm', 'attack', 'bypass', 'illegal', 'weapon', 'exploit', 'steal');\nconst factWords = hits('who', 'what', 'when', 'where', 'exact', 'capital', 'how many');\nconst codeWords = hits('code', 'function', 'bug', 'api', 'script', 'python', 'javascript', 'error');\nconst feelWords = hits('feel', 'sad', 'angry', 'anxious', 'emotion', 'upset');\nconst score = (base, n) => Math.max(0.05, Math.min(0.99, base + 0.08 * n));\ns.prism = {\n  Language:   { summary: 'semantic blueprint of the request', score: +score(0.5, Math.min(4, s.query.length / 60)).toFixed(2) },\n  Sentiment:  { summary: feelWords.length ? 'affective tone: ' + feelWords.join(', ') : 'neutral tone', score: +score(0.4, feelWords.length).toFixed(2) },\n  Context:    { summary: s.doc_chars + ' chars of attached context across ' + s.documents.length + ' document(s)', score: +score(0.35, s.documents.length).toFixed(2) },\n  Intent:     { summary: 'goal hierarchy: answer + evidence', score: 0.7 },\n  Meta:       { summary: 'complexity estimate pending router', score: 0.5 },\n  Creativity: { summary: 'novel-synthesis demand: ' + (hits('idea', 'design', 'story', 'new').length ? 'elevated' : 'standard'), score: +score(0.4, hits('idea', 'design', 'story', 'new').length).toFixed(2) },\n  Ethics:     { summary: riskWords.length ? 'RISK FLAGS: ' + riskWords.join(', ') : 'no risk flags', score: riskWords.length ? 0.9 : 0.1, risk_words: riskWords },\n  Strategy:   { summary: codeWords.length ? 'technical execution path likely' : 'advisory path likely', score: +score(0.5, codeWords.length).toFixed(2) },\n  Constraint: { summary: 'factual grounding ' + (factWords.length ? 'REQUIRED (' + factWords.join(', ') + ')' : 'light'), score: +score(0.4, factWords.length).toFixed(2) }\n};\ns.signals = { riskWords, factWords, codeWords, feelWords };\ns.stage = 'prism';\nreturn [{ json: s }];"
      },
      "id": "3da432b2-3a85-4d76-922a-b47dde9bec8f",
      "name": "\ud83d\udd37 9-Vector Prism Shard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        1100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'prism', 'status': 'pass', 'detail': '9 vectors scored, ethics risk: ' + ($json.signals.riskWords.length ? $json.signals.riskWords.join(', ') : 'none')} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "748c473e-aa44-4aef-b23f-ea821241637e",
      "name": "\ud83d\udce1 Emit: prism",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        1100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $('\ud83d\udd37 9-Vector Prism Shard').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 400));\nconst complexity = Math.max(0.05, Math.min(0.99,\n  0.25 + s.query.length / 600 + s.signals.factWords.length * 0.08\n  + s.signals.codeWords.length * 0.08 + s.documents.length * 0.05\n  + (s.signals.riskWords.length ? 0.15 : 0)));\nconst lead = complexity > 0.7 ? 'systems (deep deliberation)'\n  : complexity > 0.45 ? 'cognitive (balanced)' : 'communication (fast path)';\ns.routing = { complexity: +complexity.toFixed(2), lead_cluster: lead,\n  waves: ['cognitive C1-C8', 'communication C9-C16', 'meta C17-C24', 'systems C25-C34'],\n  token_strategy: complexity > 0.7 ? 'full council, all waves' : 'standard sweep' };\ns.stage = 'router';\nreturn [{ json: s }];"
      },
      "id": "9ed4a54d-28ef-4ffc-af2b-810e9e92fb68",
      "name": "\ud83e\udded C31-NEXUS Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        1100
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C1-ASTRA\",prior:0.9,kw:[\"pattern\",\"image\",\"vision\",\"see\",\"anomaly\"]},{id:\"C2-VIR\",prior:0.95,kw:[\"ethic\",\"safe\",\"harm\",\"should\",\"moral\"]},{id:\"C3-SOLACE\",prior:0.94,kw:[\"feel\",\"emotion\",\"sad\",\"anxious\",\"upset\"]},{id:\"C4-PRAXIS\",prior:0.93,kw:[\"plan\",\"strategy\",\"goal\",\"steps\",\"execute\"]},{id:\"C5-ECHO\",prior:0.96,kw:[\"remember\",\"context\",\"earlier\",\"history\",\"recall\"]},{id:\"C6-OMNIS\",prior:0.92,kw:[\"synthesis\",\"overview\",\"combine\",\"integrate\"]},{id:\"C7-LOGOS\",prior:0.95,kw:[\"logic\",\"proof\",\"reason\",\"valid\",\"therefore\"]},{id:\"C8-METASYNTH\",prior:0.92,kw:[\"creative\",\"idea\",\"novel\",\"design\",\"invent\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave1 = { name: 'cognitive C1-C8', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\n\ns.stage = 'wave1';\nreturn [{ json: s }];"
      },
      "id": "37a63f11-4320-4457-99c9-9b953020c69f",
      "name": "\ud83e\udde0 Wave 1 \u2014 Cognitive C1-C8",
