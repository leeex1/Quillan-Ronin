    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C9-AETHER\",prior:0.91,kw:[\"meaning\",\"semantic\",\"language\",\"word\",\"metaphor\"]},{id:\"C10-CODEWEAVER\",prior:0.91,kw:[\"code\",\"function\",\"bug\",\"script\",\"program\"]},{id:\"C11-HARMONIA\",prior:0.9,kw:[\"balance\",\"tradeoff\",\"consensus\",\"both sides\"]},{id:\"C12-SOPHIAE\",prior:0.93,kw:[\"future\",\"wisdom\",\"long-term\",\"consequence\"]},{id:\"C13-WARDEN\",prior:0.97,kw:[\"security\",\"threat\",\"risk\",\"danger\",\"attack\"]},{id:\"C14-KAIDO\",prior:0.89,kw:[\"fast\",\"efficient\",\"optimize\",\"speed\",\"latency\"]},{id:\"C15-LUMINARIS\",prior:0.88,kw:[\"clear\",\"visual\",\"chart\",\"explain simply\"]},{id:\"C16-VOXUM\",prior:0.92,kw:[\"tone\",\"write\",\"email\",\"speech\",\"persuade\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave2 = { name: 'communication C9-C16', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\n\ns.stage = 'wave2';\nreturn [{ json: s }];"
