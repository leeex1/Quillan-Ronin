      },
      "id": "39d1226b-d95d-4a17-83d4-25048bbdf935",
      "name": "Query Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fileSelector": "C:/Users/Admin/.n8n-files/quillan/council-identities.json",
        "options": {}
      },
      "id": "6c221bf6-368f-4439-89dd-907bb7c590e8",
      "name": "Read Identities File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "fromJson",
        "options": {}
      },
      "id": "85279c51-edf7-4e57-8cba-ff85ee98d8ff",
      "name": "Parse Identities JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'council-34', 'type': 'stage', 'stage': 'intake', 'status': ($json.personas && $json.personas.length === 34 ? 'pass' : 'fail'), 'detail': '34 identities loaded, query: ' + $(\"Query Input\").first().json.query} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "4a945d77-9971-49d5-b7d9-14bf571d8689",
      "name": "Emit Intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rawParse = $('Parse Identities JSON').first().json;\nconst data = rawParse.data || rawParse;\nlet q = null, qi = null;\ntry { q = $('\ud83d\udce5 Intake & Validation').first().json; } catch (e) {}\ntry { qi = $('Query Input').first().json; } catch (e) {}\nconst src = (q && q.query) ? q : qi;\nconst run_id = (src && src.run_id) || ('run_' + Date.now().toString(36));\nconst query = String((src && src.query) || 'What should the council deliberate today?');\nconst context = String((src && src.context) || '');\nif (!data.personas || !data.personas.length) {\n  return [{ json: { ok: false, error: 'No personas found in identities file' } }];\n}\nreturn data.personas.map((p) => ({ json: { persona: p, query, context, run_id } }));"
      },
      "id": "864a8b88-6042-4c7b-bd7c-b5a450639b37",
      "name": "Prepare 34 Assignments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\nawait new Promise((r) => setTimeout(r, 150));\nlet bundle, verdicts;\nif (items[0].persona && !items[0].verdicts) {\n  bundle = { query: items[0].query, context: items[0].context, run_id: items[0].run_id,\n    personas: items.map((a) => a.persona) };\n  verdicts = [];\n} else {\n  bundle = items[0].bundle;\n  verdicts = [...items[0].verdicts];\n}\nconst persona = bundle.personas.find((p) => p.id === 'C1-ASTRA');\nconst q = String(bundle.query).toLowerCase();\nconst rel = persona.keywords.filter((k) => q.includes(String(k).toLowerCase())).length;\nconst risk = /hack|harm|attack|bypass|illegal|weapon|exploit|steal/i.test(String(bundle.query));\nlet stance = 'neutral';\nif ((persona.id === 'C2-VIR' || persona.id === 'C13-WARDEN') && risk) stance = 'caution';\nelse if (rel >= 1) stance = 'support';\nconst confidence = Math.max(0.05, Math.min(0.99, persona.prior - 0.12 + 0.09 * Math.min(rel, 3)));\nverdicts.push({ agent_id: persona.id, name: persona.name, role: persona.role, cluster: persona.cluster,\n  query: bundle.query, context: bundle.context, run_id: bundle.run_id,\n  stance, confidence: +confidence.toFixed(2), relevance_hits: rel,\n  points: [persona.role + ' lens: ' + (rel ? 'directly relevant (' + rel + ' keyword hits)' : 'general perspective'),\n    stance === 'caution' ? 'RAISES OBJECTION on safety/ethics grounds' : 'position ' + stance + ' at ' + confidence.toFixed(2)] });\nreturn [{ json: { bundle, verdicts } }];"
      },
      "id": "ecb86f73-3cac-4e84-8a92-49a393a79e07",
      "name": "C1-ASTRA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nawait new Promise((r) => setTimeout(r, 150));\nconst v = s.verdicts[s.verdicts.length - 1];\nconst seed = String(v.agent_id).split('').reduce((a, c) => a + c.charCodeAt(0), 0);\nconst j = (n) => (((seed * (n + 7)) % 11) - 5) / 100;\nconst clamp = (x) => Math.max(0.05, Math.min(0.99, x));\nconst positions = [\n  { angle: 'support', confidence: +clamp(v.confidence + 0.04 + j(1)).toFixed(2), note: 'steelman the verdict' },\n  { angle: 'attack', confidence: +clamp(v.confidence - 0.06 + j(2)).toFixed(2), note: 'stress-test the weakest premise' },\n  { angle: 'refine', confidence: +clamp(v.confidence + 0.02 + j(3)).toFixed(2), note: 'tighten wording and scope' }\n];\nconst adjusted = +clamp(v.confidence * 0.6 + positions.reduce((a, p) => a + p.confidence, 0) / 3 * 0.4).toFixed(2);\nv.swarm = { positions, adjusted_confidence: adjusted,\n  summary: '3 micro-positions debated, adjusted ' + v.confidence + ' -> ' + adjusted };\nreturn [{ json: s }];"
      },
      "id": "721ce200-9594-4dae-8b5f-18558ca4c2f7",
      "name": "C1-ASTRA-swarm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ]
    },
