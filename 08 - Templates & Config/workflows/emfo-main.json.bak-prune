    {
      "parameters": {
        "jsCode": "const s = $('\ud83d\udde3 Wave 2 \u2014 Communication C9-C16').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C17-NULLION\",prior:0.91,kw:[\"paradox\",\"contradict\",\"ambiguous\",\"uncertain\"]},{id:\"C18-SHEPHERD\",prior:0.96,kw:[\"true\",\"fact\",\"cite\",\"source\",\"evidence\",\"exact\"]},{id:\"C19-VIGIL\",prior:0.94,kw:[\"identity\",\"consistent\",\"drift\",\"reliable\"]},{id:\"C20-ARTIFEX\",prior:0.9,kw:[\"tool\",\"api\",\"automate\",\"workflow\",\"integrate\"]},{id:\"C21-ARCHON\",prior:0.92,kw:[\"research\",\"study\",\"paper\",\"deep dive\"]},{id:\"C22-AURELION\",prior:0.87,kw:[\"design\",\"beautiful\",\"style\",\"aesthetic\"]},{id:\"C23-CADENCE\",prior:0.86,kw:[\"audio\",\"music\",\"rhythm\",\"sound\"]},{id:\"C24-SCHEMA\",prior:0.9,kw:[\"format\",\"structure\",\"table\",\"template\",\"json\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave3 = { name: 'meta C17-C24', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\ns.waves.wave3.paradox_detected = ['but ', 'however', 'contradict', 'paradox', 'both '].some((w) => q.includes(w));\ns.waves.wave3.citations_needed = s.signals.factWords.length > 0;\ns.stage = 'wave3';\nreturn [{ json: s }];"
      },
      "id": "3832edfd-b70c-4ee7-9e8d-2b209f2b61bc",
      "name": "\ud83c\udf00 Wave 3 \u2014 Meta C17-C24",
      "type": "n8n-nodes-base.code",
