    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfec3b0a-16cc-4848-bfbf-046d55cfcca3",
              "name": "query",
              "value": "Should we automate our weekly reporting with n8n?",
