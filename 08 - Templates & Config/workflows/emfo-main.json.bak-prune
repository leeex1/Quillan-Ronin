    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map((i) => i.json);\nconst first = items[0] || {};\nconst th = first.verdict ? first : (first.data && first.data[0]) || first;\nconst lines = [\n  'QUILLAN COUNCIL VERDICT',\n  'verdict: ' + (th.verdict || 'unknown'),\n  'confidence: ' + (th.confidence || '?'),\n  'query: ' + (th.query || ''),\n  '',\n  String(th.answer || th.report || JSON.stringify(th).slice(0, 2000))\n];\nreturn [{ json: { verdict_file: lines.join('\\n'), run_id: th.run_id || '' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3320,
        750
      ],
      "id": "ff178d83-dbeb-47fa-8988-1e6f5a885aea",
      "name": "Code in Python"
    },
    {
      "parameters": {
