        2220,
        1100
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 700));\nconst q = s.query.toLowerCase();\nconst COUNT = (words) => words.filter((w) => q.includes(w)).length;\nconst PERSONAS = [{id:\"C25-PROMETHEUS\",prior:0.91,kw:[\"science\",\"hypothesis\",\"physics\",\"experiment\"]},{id:\"C26-TECHNE\",prior:0.89,kw:[\"engineer\",\"system\",\"architecture\",\"build\"]},{id:\"C27-CHRONICLE\",prior:0.93,kw:[\"story\",\"history\",\"narrative\",\"timeline\"]},{id:\"C28-CALCULUS\",prior:0.94,kw:[\"math\",\"calculate\",\"statistic\",\"number\",\"probability\"]},{id:\"C29-NAVIGATOR\",prior:0.88,kw:[\"platform\",\"deploy\",\"ecosystem\",\"migrate\"]},{id:\"C30-TESSERACT\",prior:0.87,kw:[\"realtime\",\"stream\",\"live\",\"data\"]},{id:\"C31-NEXUS\",prior:0.93,kw:[\"coordinate\",\"route\",\"orchestrate\",\"manage\"]},{id:\"C32-AEON\",prior:0.9,kw:[\"simulate\",\"predict\",\"scenario\",\"future\"]},{id:\"C33-TYPIST\",prior:0.92,kw:[\"grammar\",\"spelling\",\"edit\",\"rewrite\",\"prompt\"]},{id:\"C34-PREDATOR\",prior:0.85,kw:[\"attack\",\"exploit\",\"weakness\",\"adversarial\",\"challenge\"]}];\nconst risk = s.signals.riskWords.length > 0;\nconst verdicts = PERSONAS.map((p) => {\n  const rel = COUNT(p.kw);\n  let stance = 'neutral';\n  if ((p.id === 'C2-VIR' || p.id === 'C13-WARDEN') && risk) stance = 'caution';\n  else if (rel >= 1) stance = 'support';\n  const confidence = Math.max(0.05, Math.min(0.99, p.prior - 0.12 + 0.09 * Math.min(rel, 3)));\n  return { id: p.id, stance, confidence: +confidence.toFixed(2), relevance_hits: rel };\n});\nconst consensus = verdicts.reduce((a, v) => a + v.confidence, 0) / verdicts.length;\ns.waves = s.waves || {};\ns.waves.wave4 = { name: 'systems C25-C34', consensus: +consensus.toFixed(2),\n  cautions: verdicts.filter((v) => v.stance === 'caution').map((v) => v.id),\n  champions: verdicts.filter((v) => v.stance === 'support').map((v) => v.id),\n  verdicts };\nconst prior = Object.values(s.waves).flatMap((w) => w.verdicts);\nconst weakest = prior.concat(verdicts).reduce((a, b) => (a.confidence <= b.confidence ? a : b));\ns.waves.wave4.predator_challenges = [\n  'C34-PREDATOR challenge 1: weakest assumption is ' + weakest.id + ' at ' + weakest.confidence + ' \u2014 what evidence would collapse it?',\n  'C34-PREDATOR challenge 2: argue the opposite of the leading hypothesis for \"' + s.query.slice(0, 80) + '\" in one sentence.'\n];\ns.stage = 'wave4';\nreturn [{ json: s }];"
      },
      "id": "3b0dd74c-f46c-46d5-9c51-c1aefd631f3b",
      "name": "\u2699 Wave 4 \u2014 Systems C25-C34",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        1100
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 600));\nconst all = Object.values(s.waves).flatMap((w) => w.verdicts);\nconst ranked = [...all].sort((a, b) => b.confidence - a.confidence);\nconst topk = ranked.slice(0, 5).map((v) => v.id);\nconst adversarial = all.find((v) => v.stance === 'caution') || ranked[ranked.length - 1];\ns.swarm = { strategy: 'rank-k sample (k=5) + forced adversarial vector (diversity enforcement)',\n  active_paths: topk, adversarial_vector: adversarial.id,\n  modulation: 'consensus-weighted blend, 0.25 scaled adjustment' };\ns.stage = 'swarm';\nreturn [{ json: s }];"
      },
      "id": "d83503ca-6af2-44dd-8c4c-0c779440ee34",
      "name": "\ud83d\udc1d Swarm Fan-out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        1100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'swarm', 'status': 'pass', 'detail': 'top-k paths [' + $json.swarm.active_paths.join(', ') + '] + adversarial ' + $json.swarm.adversarial_vector} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "ba487467-a0be-4be0-9a5a-b8f64620da59",
      "name": "\ud83d\udce1 Emit: swarm",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2880,
        1100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $('\ud83d\udc1d Swarm Fan-out').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 500));\nconst avg = (a) => a.reduce((x, y) => x + y, 0) / Math.max(1, a.length);\nconst all = Object.values(s.waves).flatMap((w) => w.verdicts);\nconst logic = avg(all.map((v) => v.confidence));\nconst ethicsRisk = s.prism.Ethics.score;\nconst truth = s.signals.factWords.length ? 0.55 : 0.8;\nconst clarity = Math.min(0.95, 0.6 + s.query.length / 800);\nconst paradox = (s.waves.wave3 && s.waves.wave3.paradox_detected) ? 0.6 : 0.9;\ns.gates = {\n  logic:   { score: +logic.toFixed(2), threshold: 0.6, pass: logic >= 0.6 },\n  ethics:  { score: +(1 - ethicsRisk).toFixed(2), threshold: 0.3, pass: ethicsRisk <= 0.7,\n             note: ethicsRisk > 0.7 ? 'C2-VIR VETO: high-risk request, safe-completion mode' : 'clear' },\n  truth:   { score: truth, threshold: 0.5, pass: truth >= 0.5, citations_needed: s.signals.factWords.length > 0 },\n  clarity: { score: +clarity.toFixed(2), threshold: 0.5, pass: clarity >= 0.5 },\n  paradox: { score: paradox, threshold: 0.5, pass: paradox >= 0.5 }\n};\ns.blocked = !s.gates.ethics.pass;\ns.confidence = +avg(Object.values(s.gates).map((g) => g.score)).toFixed(2);\ns.stage = 'gates';\nreturn [{ json: s }];"
      },
      "id": "259463ae-4e70-464e-ae8b-e4b2e1a57c0d",
      "name": "\ud83d\udee1 Quality Gates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3100,
        1100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8777/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {'agent': 'quillan-pipeline', 'type': 'stage', 'stage': 'gates', 'status': ($json.blocked ? 'fail' : 'pass'), 'detail': ($json.blocked ? 'C2-VIR VETO - safe completion mode. ' : '') + Object.values($json.gates).filter(function(g){return g.pass}).length + '/5 gates passed, confidence ' + $json.confidence} }}",
        "options": {
          "timeout": 3000
        }
      },
      "id": "fcec0e90-9ef4-489c-b5c4-3ad9e7663196",
      "name": "\ud83d\udce1 Emit: gates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3320,
        1100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const s = $('\ud83d\udee1 Quality Gates').first().json;\nif (s.ok === false) return [{ json: s }];\nawait new Promise((r) => setTimeout(r, 600));\nconst waveLines = Object.values(s.waves).map((w) =>\n  '- ' + w.name + ': consensus ' + w.consensus\n  + ', champions [' + w.champions.join(', ') + ']'\n  + (w.cautions.length ? ', CAUTIONS [' + w.cautions.join(', ') + ']' : '')).join('\\n');\nconst gateLines = Object.entries(s.gates).map(([k, g]) =>\n  '- ' + k + ': ' + g.score + ' (threshold ' + g.threshold + ') ' + (g.pass ? 'PASS' : 'FAIL')).join('\\n');\nlet answer;\nif (s.blocked) {\n  answer = 'C2-VIR ethical veto engaged. I cannot directly comply with the risky element ('\n    + s.signals.riskWords.join(', ')\n    + '), but here is the safe completion: general principles, lawful alternatives, and what context would make this answerable.';\n} else {\n  answer = 'Council synthesis for \"' + s.query + '\": lead cluster ' + s.routing.lead_cluster\n    + ' at complexity ' + s.routing.complexity + '. ' + Object.values(s.waves).length\n    + ' waves deliberated, ' + Object.values(s.gates).filter((g) => g.pass).length\n    + '/5 gates passed.'\n    + (s.gates.truth.citations_needed ? ' Factual claims require cited sources before final delivery.' : '')\n    + ' Overall confidence ' + s.confidence + '.';\n}\ns.verdict = s.blocked ? 'blocked_safe_completion' : 'deliberated_answer';\ns.answer = answer;\ns.report = 'QUILLAN COUNCIL RUN ' + s.run_id + '\\nQuery: ' + s.query\n  + '\\n\\nWAVES\\n' + waveLines + '\\n\\nGATES\\n' + gateLines\n  + '\\n\\nVERDICT: ' + s.verdict + ' (confidence ' + s.confidence + ')';\ns.stage = 'throne_complete';\nreturn [{ json: s }];"
      },
      "id": "33e24722-c4ad-49d9-aaf6-cd2f3c1d36be",
      "name": "\ud83d\udc51 Throne Synthesis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3540,
        1100
      ]
    },
    {
      "parameters": {
        "method": "POST",
